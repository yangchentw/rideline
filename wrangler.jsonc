{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rideline",
	"account_id": "8ff4491c19270876c6de2a747400b717",
	"workers_dev": true,
	"main": "server/worker.js",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rideline-db",
			"database_id": "45878cfa-da6d-4c99-be29-5689cc560b32"
		}
	]
}
